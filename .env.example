# Template of the environment variables the app reads.
# LOCAL:  copy this to `.env` and fill in values (the .env file is gitignored).
# RENDER: do NOT commit real values — set these in the Render dashboard instead
#         (Environment tab), matching the keys in render.yaml.

# ── Required ─────────────────────────────────────────────────────────────────
ADMIN_USER=your_admin_username
FINNHUB_API_KEY=
ANTHROPIC_API_KEY=

# Broker-key encryption (Fernet). Generate ONCE and keep forever:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_ENC_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Session cookie signing (any long random string). On Render this is auto-generated.
SESSION_SECRET=

# Email (password reset, briefings)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587

# On Render only: the persistent-disk mount. Leave BLANK locally.
DATA_DIR=

# Moomoo (LOCAL ONLY — needs OpenD on your PC; does not work on Render)
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_CASH_ACC_ID=0
